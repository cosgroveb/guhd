#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 3 ]]; then
    printf 'usage: %s VERSION ARM64_SHA256 AMD64_SHA256\n' "$0" >&2
    exit 2
fi
root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version=$("$root_dir/scripts/release-version" "v$1")
for checksum in "$2" "$3"; do
    [[ $checksum =~ ^[0-9a-f]{64}$ ]] || { printf 'invalid SHA-256 checksum\n' >&2; exit 2; }
done
cat <<EOF_FORMULA
class Guhd < Formula
  desc "Terminal dashboard for Google Workspace and Git repositories"
  homepage "https://github.com/cosgroveb/guhd"
  version "$version"
  license "Apache-2.0"

  depends_on "git"
  depends_on "openclaw/tap/gogcli"
  depends_on :macos

  on_macos do
    on_arm do
      url "https://github.com/cosgroveb/guhd/releases/download/v$version/guhd_${version}_darwin_arm64.tar.gz"
      sha256 "$2"
    end

    on_intel do
      url "https://github.com/cosgroveb/guhd/releases/download/v$version/guhd_${version}_darwin_amd64.tar.gz"
      sha256 "$3"
    end
  end

  def install
    bin.install "guhd"
    man1.install "man/man1/guhd.1"
    doc.install "LICENSE", "README.md", "copyright", "third-party-licenses"
  end

  test do
    assert_equal "guhd #{version}", shell_output("#{bin}/guhd --version").strip
    assert_match "Google unified heads up display", shell_output("#{bin}/guhd --help")
    assert_path_exists man1/"guhd.1"
    assert_path_exists doc/"LICENSE"
    assert_path_exists doc/"README.md"
    assert_predicate Formula["openclaw/tap/gogcli"].opt_bin/"gog", :executable?
  end
end
EOF_FORMULA
